#!/usr/bin/env bash

# ============================================================
# OmniRoute - Post Instalacion IA-SERVER
# PCCURICO SPA
#
# Uso:
#   sudo bash OmniRoute-PostInstalacion.sh
#
# Objetivo:
#   Configurar y optimizar OmniRoute despues de la instalacion
#   principal de IA-SERVER.
#
# No reinstala LAMP, PHP, MySQL ni Ollama.
# ============================================================

set -o pipefail

APP_NAME="OmniRoute"
LOG_FILE="/var/log/omniroute-postinstall.log"
BACKUP_ROOT="/var/backups/omniroute"
SERVICE_NAME="omniroute"
OMNI_PORT="20128"
OLLAMA_PORT="11434"

# ------------------------------------------------------------
# Colores
# ------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# ------------------------------------------------------------
# Utilidades
# ------------------------------------------------------------

log() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")"
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" | tee -a "$LOG_FILE"
}

info() {
    echo -e "${CYAN}[INFO]${NC} $1"
    log "[INFO] $1"
}

ok() {
    echo -e "${GREEN}[OK]${NC} $1"
    log "[OK] $1"
}

warn() {
    echo -e "${YELLOW}[AVISO]${NC} $1"
    log "[AVISO] $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
    log "[ERROR] $1"
}

die() {
    error "$1"
    exit 1
}

separator() {
    echo
    printf '%*s\n' 72 '' | tr ' ' '='
    echo
}

pause_menu() {
    echo
    read -r -p "Presiona ENTER para continuar..." _
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        die "Este script debe ejecutarse como root: sudo bash $0"
    fi
}

check_os() {
    if [[ ! -f /etc/os-release ]]; then
        die "No se pudo determinar el sistema operativo."
    fi

    # shellcheck disable=SC1091
    source /etc/os-release

    if [[ "${ID}" != "ubuntu" ]]; then
        warn "Sistema detectado: ${PRETTY_NAME}"
        warn "Este post-instalador fue diseñado para Ubuntu Server."
    fi

    if [[ "${VERSION_ID:-}" != "24.04" ]]; then
        warn "Version detectada: ${VERSION_ID:-desconocida}"
        warn "La plataforma objetivo es Ubuntu Server 24.04 LTS."
    fi
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

get_lan_ip() {
    local ip=""

    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"

    if [[ -z "$ip" ]]; then
        ip="$(ip route get 1.1.1.1 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')"
    fi

    echo "${ip:-127.0.0.1}"
}

get_lan_cidr() {
    local ip="$1"
    local cidr=""

    cidr="$(ip -o -f inet addr show 2>/dev/null | awk -v ip="$ip" '$4 ~ "^"ip"/" {print $4; exit}')"

    if [[ -n "$cidr" ]]; then
        echo "$cidr"
        return
    fi

    echo ""
}

detect_omniroute_command() {
    if command_exists omniroute; then
        echo "omniroute"
        return
    fi

    if [[ -x "/usr/local/bin/omniroute" ]]; then
        echo "/usr/local/bin/omniroute"
        return
    fi

    if [[ -x "/usr/bin/omniroute" ]]; then
        echo "/usr/bin/omniroute"
        return
    fi

    echo ""
}

OMNI_CMD=""

detect_paths() {

    OMNI_CMD="$(detect_omniroute_command)"

    OMNI_GLOBAL_ROOT=""

    if command_exists npm; then
        OMNI_GLOBAL_ROOT="$(npm root -g 2>/dev/null || true)"
    fi

    export OMNI_CMD
    export OMNI_GLOBAL_ROOT
}

show_header() {

    clear

    echo -e "${CYAN}"
    cat <<'EOF'
 ██████╗ ███╗   ███╗███╗   ██╗██╗██████╗  ██████╗ ██╗   ██╗████████╗███████╗
██╔═══██╗████╗ ████║████╗  ██║██║██╔══██╗██╔═══██╗██║   ██║╚══██╔══╝██╔════╝
██║   ██║██╔████╔██║██╔██╗ ██║██║██████╔╝██║   ██║██║   ██║   ██║   █████╗
██║   ██║██║╚██╔╝██║██║╚██╗██║██║██╔══██╗██║   ██║██║   ██║   ██║   ██╔══╝
╚██████╔╝██║ ╚═╝ ██║██║ ╚████║██║██║  ██║╚██████╔╝╚██████╔╝   ██║   ███████╗
 ╚═════╝ ╚═╝     ╚═╝╚═╝  ╚═══╝╚═╝╚═╝  ╚═╝ ╚═════╝  ╚═════╝    ╚═╝   ╚══════╝
EOF
    echo -e "${NC}"

    echo
    echo -e "${WHITE}OmniRoute - Post Instalacion${NC}"
    echo "PCCURICO SPA"
    echo "IA-SERVER"
    echo
}

check_omniroute() {

    detect_paths

    if [[ -n "$OMNI_CMD" ]]; then
        ok "OmniRoute encontrado: $OMNI_CMD"
    else
        error "OmniRoute no fue encontrado."
        echo
        echo "Instala OmniRoute primero con el instalador principal."
        return 1
    fi

    echo

    "$OMNI_CMD" --version 2>/dev/null || \
    "$OMNI_CMD" version 2>/dev/null || \
    warn "No fue posible obtener la version mediante CLI."
}

check_ollama() {

    echo

    if ! command_exists ollama; then
        error "Ollama no esta instalado."
        return 1
    fi

    ok "Ollama encontrado."

    if systemctl is-active --quiet ollama 2>/dev/null; then
        ok "Servicio Ollama activo."
    else
        warn "Servicio Ollama no esta activo."
    fi

    if curl -fsS --max-time 5 "http://127.0.0.1:${OLLAMA_PORT}/api/tags" >/dev/null 2>&1; then
        ok "API Ollama responde en 127.0.0.1:${OLLAMA_PORT}."
    else
        warn "API Ollama no responde en 127.0.0.1:${OLLAMA_PORT}."
    fi
}

show_system() {

    separator

    echo -e "${WHITE}ESTADO DEL IA-SERVER${NC}"
    echo

    echo "Hostname : $(hostname)"
    echo "IP LAN   : $(get_lan_ip)"
    echo "Red LAN  : $(get_lan_cidr "$(get_lan_ip)")"
    echo

    echo "Kernel:"
    uname -r

    echo
    echo "Memoria:"
    free -h

    echo
    echo "Disco:"
    df -h /

    echo
    echo "CPU:"
    nproc

    echo
    echo "OmniRoute:"

    if [[ -n "$OMNI_CMD" ]]; then
        "$OMNI_CMD" --version 2>/dev/null || true
    else
        echo "No instalado"
    fi

    echo
    echo "Ollama:"

    if command_exists ollama; then
        ollama --version 2>/dev/null || true
    else
        echo "No instalado"
    fi

    echo
    echo "Puertos:"

    ss -lntp 2>/dev/null | grep -E ":(${OMNI_PORT}|${OLLAMA_PORT})\b" || \
        echo "No se encontraron puertos OmniRoute/Ollama."

    pause_menu
}

show_models() {

    separator

    echo -e "${WHITE}MODELOS OLLAMA${NC}"
    echo

    if ! command_exists ollama; then
        error "Ollama no esta instalado."
        pause_menu
        return
    fi

    ollama list

    echo
    echo "Modelos actualmente cargados:"
    echo

    ollama ps 2>/dev/null || true

    pause_menu
}

backup_configuration() {

    mkdir -p "$BACKUP_ROOT"

    local timestamp
    timestamp="$(date '+%Y%m%d-%H%M%S')"

    local backup_dir="${BACKUP_ROOT}/${timestamp}"

    mkdir -p "$backup_dir"

    info "Creando backup en:"
    echo "$backup_dir"

    # Configuraciones conocidas.
    local paths=(
        "/etc/systemd/system/omniroute.service"
        "/etc/systemd/system/omniroute.service.d"
        "/root/.config/omniroute"
        "/root/.omniroute"
    )

    local p

    for p in "${paths[@]}"; do

        if [[ -e "$p" ]]; then

            local safe
            safe="${p#/}"
            safe="${safe//\//_}"

            cp -a "$p" "${backup_dir}/${safe}" 2>/dev/null || true

            ok "Backup: $p"
        fi

    done

    # Buscar archivos de configuracion relacionados con OmniRoute.
    if [[ -n "$OMNI_GLOBAL_ROOT" && -d "$OMNI_GLOBAL_ROOT" ]]; then

        find "$OMNI_GLOBAL_ROOT" \
            -maxdepth 3 \
            -type f \
            \( -iname '*config*' -o -iname '*.json' -o -iname '*.yaml' -o -iname '*.yml' \) \
            -print 2>/dev/null \
            | head -100 \
            > "${backup_dir}/detected-config-files.txt" || true

    fi

    echo "$backup_dir" > "${BACKUP_ROOT}/LAST_BACKUP"

    ok "Backup completado."

    log "Backup creado: $backup_dir"
}

find_service_file() {

    local candidates=(
        "/etc/systemd/system/omniroute.service"
        "/lib/systemd/system/omniroute.service"
        "/usr/lib/systemd/system/omniroute.service"
    )

    local file

    for file in "${candidates[@]}"; do
        if [[ -f "$file" ]]; then
            echo "$file"
            return
        fi
    done

    echo ""
}

show_service() {

    separator

    echo -e "${WHITE}SERVICIO OMNIROUTE${NC}"
    echo

    local service_file
    service_file="$(find_service_file)"

    if [[ -n "$service_file" ]]; then
        echo "Archivo:"
        echo "$service_file"
        echo
        sed -n '1,240p' "$service_file"
    else
        warn "No se encontro archivo systemd de OmniRoute."
    fi

    echo

    systemctl status "$SERVICE_NAME" --no-pager -l 2>/dev/null || true

    pause_menu
}

create_systemd_override() {

    separator

    echo -e "${WHITE}CONFIGURACION SYSTEMD OMNIROUTE${NC}"
    echo

    if [[ -z "$OMNI_CMD" ]]; then
        die "OmniRoute no esta instalado."
    fi

    backup_configuration

    mkdir -p "/etc/systemd/system/${SERVICE_NAME}.service.d"

    cat > "/etc/systemd/system/${SERVICE_NAME}.service.d/override.conf" <<EOF
[Service]

# Politica de reinicio
Restart=on-failure
RestartSec=5

# Limite razonable para el servidor IA
LimitNOFILE=65535

# Variables de entorno
Environment="NODE_ENV=production"
Environment="HOST=0.0.0.0"
Environment="PORT=${OMNI_PORT}"
EOF

    systemctl daemon-reload

    ok "Override systemd creado."

    if systemctl list-unit-files | grep -q "^${SERVICE_NAME}\.service"; then

        systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || true
        systemctl restart "$SERVICE_NAME" || true

        sleep 3

        if systemctl is-active --quiet "$SERVICE_NAME"; then
            ok "OmniRoute esta activo."
        else
            warn "OmniRoute no quedo activo. Revisar logs."
        fi

    else

        warn "No existe el servicio systemd ${SERVICE_NAME}."
        warn "El instalador actual puede estar ejecutando OmniRoute de otra forma."
    fi
}

configure_ollama_local() {

    separator

    echo -e "${WHITE}OLLAMA COMO BACKEND LOCAL${NC}"
    echo

    if ! command_exists ollama; then
        error "Ollama no esta instalado."
        pause_menu
        return
    fi

    if [[ ! -d /etc/systemd/system/ollama.service.d ]]; then
        mkdir -p /etc/systemd/system/ollama.service.d
    fi

    local override="/etc/systemd/system/ollama.service.d/override.conf"

    if [[ -f "$override" ]]; then

        cp -a "$override" "${override}.backup-$(date '+%Y%m%d-%H%M%S')"

        warn "Se creo backup del override existente."

    fi

    cat > "$override" <<EOF
[Service]
Environment="OLLAMA_HOST=0.0.0.0:${OLLAMA_PORT}"
EOF

    systemctl daemon-reload
    systemctl restart ollama

    sleep 3

    if systemctl is-active --quiet ollama; then
        ok "Ollama activo."
    else
        error "Ollama no pudo iniciar."
        systemctl status ollama --no-pager -l || true
        pause_menu
        return
    fi

    echo

    if curl -fsS --max-time 5 \
        "http://127.0.0.1:${OLLAMA_PORT}/api/tags" >/dev/null 2>&1; then

        ok "API Ollama responde."

    else

        error "API Ollama no responde."
    fi

    echo
    echo "Backend que OmniRoute debe utilizar:"
    echo
    echo "http://127.0.0.1:${OLLAMA_PORT}"
    echo

    pause_menu
}

configure_firewall() {

    separator

    echo -e "${WHITE}FIREWALL LAN${NC}"
    echo

    if ! command_exists ufw; then
        warn "UFW no esta instalado."
        pause_menu
        return
    fi

    local ip
    ip="$(get_lan_ip)"

    local cidr
    cidr="$(get_lan_cidr "$ip")"

    if [[ -z "$cidr" ]]; then
        warn "No se pudo determinar automaticamente la red LAN."
        read -r -p "Ingrese CIDR LAN, ejemplo 192.168.1.0/24: " cidr
    fi

    if [[ -z "$cidr" ]]; then
        error "CIDR LAN no definido."
        pause_menu
        return
    fi

    echo
    echo "Red LAN detectada:"
    echo "$cidr"
    echo

    read -r -p "Aplicar reglas para OmniRoute y Ollama? [S/n]: " answer

    if [[ "${answer,,}" == "n" ]]; then
        return
    fi

    ufw allow from "$cidr" to any port "$OMNI_PORT" proto tcp
    ufw allow from "$cidr" to any port "$OLLAMA_PORT" proto tcp

    ok "Firewall configurado para la LAN."

    echo
    ufw status numbered

    pause_menu
}

test_omniroute() {

    separator

    echo -e "${WHITE}PRUEBA OMNIROUTE${NC}"
    echo

    local url="http://127.0.0.1:${OMNI_PORT}"

    echo "Endpoint:"
    echo "$url"
    echo

    if curl -I --max-time 10 "$url" 2>/dev/null; then
        echo
        ok "OmniRoute responde por HTTP."
    else
        error "OmniRoute no responde."
    fi

    echo
    echo "API compatible OpenAI:"
    echo "http://$(get_lan_ip):${OMNI_PORT}/v1"
    echo

    echo "Prueba /v1/models:"
    echo

    curl -sS --max-time 15 \
        "http://127.0.0.1:${OMNI_PORT}/v1/models" \
        | head -c 5000

    echo
    echo

    pause_menu
}

show_network_configuration() {

    separator

    local ip
    ip="$(get_lan_ip)"

    local cidr
    cidr="$(get_lan_cidr "$ip")"

    echo -e "${WHITE}CONFIGURACION DE RED${NC}"
    echo

    echo "Hostname:"
    echo "  $(hostname)"
    echo

    echo "IP LAN:"
    echo "  $ip"
    echo

    echo "CIDR:"
    echo "  ${cidr:-No detectado}"
    echo

    echo "OmniRoute:"
    echo "  http://${ip}:${OMNI_PORT}"
    echo "  http://${ip}:${OMNI_PORT}/v1"
    echo

    echo "Ollama:"
    echo "  http://${ip}:${OLLAMA_PORT}"
    echo

    echo "Para VS Code:"
    echo "  http://${ip}:${OMNI_PORT}/v1"
    echo

    pause_menu
}

restart_services() {

    separator

    echo -e "${WHITE}REINICIO DE SERVICIOS IA${NC}"
    echo

    if systemctl list-unit-files | grep -q "^ollama.service"; then

        systemctl restart ollama

        if systemctl is-active --quiet ollama; then
            ok "Ollama reiniciado."
        else
            error "Ollama no pudo iniciar."
        fi

    fi

    if systemctl list-unit-files | grep -q "^${SERVICE_NAME}.service"; then

        systemctl restart "$SERVICE_NAME"

        if systemctl is-active --quiet "$SERVICE_NAME"; then
            ok "OmniRoute reiniciado."
        else
            error "OmniRoute no pudo iniciar."
        fi

    fi

    pause_menu
}

show_logs() {

    separator

    echo -e "${WHITE}LOG OMNIROUTE POST-INSTALACION${NC}"
    echo

    if [[ -f "$LOG_FILE" ]]; then
        tail -n 150 "$LOG_FILE"
    else
        echo "No existe log."
    fi

    pause_menu
}

restore_last_backup() {

    separator

    echo -e "${WHITE}RESTAURAR ULTIMO BACKUP${NC}"
    echo

    if [[ ! -f "${BACKUP_ROOT}/LAST_BACKUP" ]]; then
        error "No existe backup registrado."
        pause_menu
        return
    fi

    local backup_dir
    backup_dir="$(cat "${BACKUP_ROOT}/LAST_BACKUP")"

    if [[ ! -d "$backup_dir" ]]; then
        error "Backup no encontrado: $backup_dir"
        pause_menu
        return
    fi

    echo "Backup:"
    echo "$backup_dir"
    echo

    read -r -p "Restaurar? [s/N]: " answer

    if [[ "${answer,,}" != "s" ]]; then
        return
    fi

    # Restaurar override systemd si existe.
    if [[ -d "${backup_dir}/etc_systemd_system_omniroute.service.d" ]]; then

        rm -rf "/etc/systemd/system/${SERVICE_NAME}.service.d"

        cp -a \
            "${backup_dir}/etc_systemd_system_omniroute.service.d" \
            "/etc/systemd/system/${SERVICE_NAME}.service.d"

        ok "Override systemd restaurado."
    fi

    systemctl daemon-reload

    if systemctl list-unit-files | grep -q "^${SERVICE_NAME}.service"; then
        systemctl restart "$SERVICE_NAME" || true
    fi

    ok "Restauracion completada."

    pause_menu
}

install_dependencies() {

    separator

    echo -e "${WHITE}DEPENDENCIAS${NC}"
    echo

    apt-get update

    apt-get install -y \
        curl \
        wget \
        ca-certificates \
        jq \
        git \
        unzip \
        net-tools \
        lsof

    ok "Dependencias instaladas."

    pause_menu
}

run_full_configuration() {

    separator

    echo -e "${WHITE}CONFIGURACION COMPLETA${NC}"
    echo

    info "Iniciando post-instalacion."

    check_omniroute || {
        pause_menu
        return
    }

    check_ollama || {
        pause_menu
        return
    }

    echo

    backup_configuration

    configure_ollama_local

    create_systemd_override

    configure_firewall

    test_omniroute

    show_network_configuration

    ok "Post-instalacion finalizada."

    pause_menu
}

main_menu() {

    while true; do

        show_header

        local ip
        ip="$(get_lan_ip)"

        echo "Servidor : $(hostname)"
        echo "IP LAN   : $ip"
        echo "OmniRoute: :${OMNI_PORT}"
        echo "Ollama   : :${OLLAMA_PORT}"

        echo
        printf '%*s\n' 72 '' | tr ' ' '-'

        echo
        echo "  1) Configuracion completa recomendada"
        echo "  2) Estado del sistema"
        echo "  3) Estado de OmniRoute"
        echo "  4) Configurar Ollama como backend local"
        echo "  5) Configurar servicio systemd de OmniRoute"
        echo "  6) Configurar firewall LAN"
        echo "  7) Ver modelos Ollama"
        echo "  8) Probar OmniRoute /v1"
        echo "  9) Ver configuracion de red"
        echo " 10) Reiniciar servicios IA"
        echo " 11) Crear backup"
        echo " 12) Restaurar ultimo backup"
        echo " 13) Ver log"
        echo " 14) Instalar dependencias"
        echo "  0) Salir"
        echo

        read -r -p "Seleccion: " option

        case "$option" in

            1)
                run_full_configuration
                ;;

            2)
                show_system
                ;;

            3)
                show_service
                ;;

            4)
                configure_ollama_local
                ;;

            5)
                create_systemd_override
                pause_menu
                ;;

            6)
                configure_firewall
                ;;

            7)
                show_models
                ;;

            8)
                test_omniroute
                ;;

            9)
                show_network_configuration
                ;;

            10)
                restart_services
                ;;

            11)
                backup_configuration
                pause_menu
                ;;

            12)
                restore_last_backup
                ;;

            13)
                show_logs
                ;;

            14)
                install_dependencies
                ;;

            0)
                echo
                ok "Post-instalacion finalizada."
                exit 0
                ;;

            *)
                warn "Opcion no valida."
                sleep 1
                ;;

        esac

    done
}

# ------------------------------------------------------------
# Inicio
# ------------------------------------------------------------

require_root
check_os
detect_paths

mkdir -p "$(dirname "$LOG_FILE")"

log "============================================================"
log "Inicio OmniRoute Post Instalacion"
log "Hostname: $(hostname)"
log "IP LAN: $(get_lan_ip)"
log "============================================================"

main_menu
