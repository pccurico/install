#!/usr/bin/env bash
#
# OmniRoute / Ollama / DNS - Administrador de Post Instalacion v2
# PCCURICO SPA
#
# Objetivo:
#   Administrar de forma segura OmniRoute, Ollama, DNS local (dnsmasq),
#   firewall UFW, systemd, backups, diagnostico y rollback.
#
# Diseñado para Ubuntu Server 24.04 LTS.
#
# IMPORTANTE:
#   - No reinstala LAMP, PHP, MySQL ni Ollama.
#   - No modifica los VirtualHost de Apache.
#   - Puede detectar VirtualHost de Apache y crear sus registros DNS locales.
#   - Todas las modificaciones gestionadas por este script tienen backup.
#
# Ejemplos:
#   sudo bash OmniRoute-PostInstalacion-v2.sh
#   sudo bash OmniRoute-PostInstalacion-v2.sh --status
#   sudo bash OmniRoute-PostInstalacion-v2.sh --diagnose
#   sudo bash OmniRoute-PostInstalacion-v2.sh --full
#   sudo bash OmniRoute-PostInstalacion-v2.sh --dry-run
#   sudo bash OmniRoute-PostInstalacion-v2.sh --help
#

set -Eeuo pipefail
IFS=$'\n\t'

APP_NAME="OmniRoute-Admin"
SCRIPT_VERSION="2.0.0"
LOG_FILE="/var/log/omniroute-admin.log"
BACKUP_ROOT="/var/backups/omniroute-admin"
STATE_ROOT="/var/lib/omniroute-admin"
LOCK_FILE="/run/omniroute-admin.lock"

OMNI_SERVICE="omniroute"
OLLAMA_SERVICE="ollama"
DNS_SERVICE="dnsmasq"
SAMBA_SERVICE="smbd"
SAMBA_NMB_SERVICE="nmbd"
SAMBA_CONFIG="/etc/samba/smb.conf"
SAMBA_INCLUDE_DIR="/etc/samba/smb.conf.d"
SAMBA_MANAGED_CONFIG="${SAMBA_INCLUDE_DIR}/90-omniroute-admin.conf"

OMNI_PORT_DEFAULT="20128"
OLLAMA_PORT_DEFAULT="11434"
DNS_PORT="53"

OMNI_BIND_DEFAULT="0.0.0.0"
OLLAMA_BIND_DEFAULT="127.0.0.1"

DNS_CONFIG_DIR="/etc/dnsmasq.d"
DNS_MAIN_CONFIG="/etc/dnsmasq.conf"
DNS_LOCAL_CONFIG="${DNS_CONFIG_DIR}/90-omniroute-local.conf"
DNS_VHOST_CONFIG="${DNS_CONFIG_DIR}/91-apache-vhosts.conf"
RESOLVED_DROPIN_DIR="/etc/systemd/resolved.conf.d"
RESOLVED_DROPIN="${RESOLVED_DROPIN_DIR}/90-local-dns.conf"

DRY_RUN=0
NON_INTERACTIVE=0
AUTO_YES=0
OMNI_CMD=""
OMNI_GLOBAL_ROOT=""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
MAGENTA='\033[0;35m'
NC='\033[0m'

log_raw() {
    local msg="${1:-}"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" >> "$LOG_FILE" 2>/dev/null || true
}

info()  { echo -e "${CYAN}[INFO]${NC} $*"; log_raw "[INFO] $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; log_raw "[OK] $*"; }
warn()  { echo -e "${YELLOW}[AVISO]${NC} $*"; log_raw "[AVISO] $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; log_raw "[ERROR] $*"; }
debug() { [[ "${DEBUG:-0}" == "1" ]] && log_raw "[DEBUG] $*" || true; }

die() {
    error "$*"
    exit 1
}

on_error() {
    local code="$?"
    local line="${1:-?}"
    local cmd="${2:-?}"
    error "Fallo en linea ${line}, codigo ${code}: ${cmd}"
    error "Revise: ${LOG_FILE}"
    exit "$code"
}
trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR

cleanup() {
    rm -f "$LOCK_FILE" 2>/dev/null || true
}
trap cleanup EXIT

separator() {
    echo
    printf '%*s\n' 82 '' | tr ' ' '='
    echo
}

pause_menu() {
    [[ "$NON_INTERACTIVE" -eq 1 ]] && return
    echo
    read -r -p "Presiona ENTER para continuar..." _
}

run() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "[DRY-RUN] $*"
        return 0
    fi
    "$@"
}

run_shell() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "[DRY-RUN] $*"
        return 0
    fi
    bash -c "$*"
}

require_root() {
    [[ "${EUID}" -eq 0 ]] || die "Ejecuta como root: sudo bash $0"
}

acquire_lock() {
    mkdir -p "$(dirname "$LOCK_FILE")"
    if [[ -e "$LOCK_FILE" ]]; then
        local old_pid=""
        old_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
        if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
            die "Ya existe otra instancia ejecutandose (PID ${old_pid})."
        fi
        rm -f "$LOCK_FILE"
    fi
    echo "$$" > "$LOCK_FILE"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

require_commands() {
    local missing=()
    local c
    for c in "$@"; do
        command_exists "$c" || missing+=("$c")
    done
    if ((${#missing[@]})); then
        die "Faltan comandos: ${missing[*]}. Usa el menu de dependencias."
    fi
}

valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

valid_ipv4() {
    local ip="$1"
    local IFS=.
    local -a octets=()
    read -r -a octets <<< "$ip"
    [[ "${#octets[@]}" -eq 4 ]] || return 1
    local o
    for o in "${octets[@]}"; do
        [[ "$o" =~ ^[0-9]{1,3}$ ]] || return 1
        ((10#$o <= 255)) || return 1
    done
}

valid_hostname() {
    local h="$1"
    [[ "$h" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]]
}

get_lan_ip() {
    local ip=""
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '
        /src/ {
            for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}
        }')"
    if [[ -z "$ip" ]]; then
        ip="$(hostname -I 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i !~ /^127\./) {print $i; exit}}')"
    fi
    echo "${ip:-127.0.0.1}"
}

get_lan_interface() {
    ip -4 route get 1.1.1.1 2>/dev/null | awk '
        /dev/ {
            for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}
        }'
}

get_lan_cidr() {
    local ip="${1:-$(get_lan_ip)}"
    ip -o -4 addr show 2>/dev/null |
        awk -v ip="$ip" '$4 ~ "^"ip"/" {print $4; exit}'
}

get_lan_network() {
    local cidr
    cidr="$(get_lan_cidr "${1:-$(get_lan_ip)}")"
    [[ -n "$cidr" ]] || return 1
    python3 - "$cidr" <<'PY'
import ipaddress, sys
try:
    print(ipaddress.ip_interface(sys.argv[1]).network)
except Exception:
    raise SystemExit(1)
PY
}

get_gateway() {
    ip -4 route show default 2>/dev/null | awk '/default/ {print $3; exit}'
}

detect_omniroute() {
    OMNI_CMD=""
    if command_exists omniroute; then
        OMNI_CMD="$(command -v omniroute)"
    elif [[ -x /usr/local/bin/omniroute ]]; then
        OMNI_CMD="/usr/local/bin/omniroute"
    elif [[ -x /usr/bin/omniroute ]]; then
        OMNI_CMD="/usr/bin/omniroute"
    fi

    OMNI_GLOBAL_ROOT=""
    if command_exists npm; then
        OMNI_GLOBAL_ROOT="$(npm root -g 2>/dev/null || true)"
    fi
    export OMNI_CMD OMNI_GLOBAL_ROOT
}

detect_service_file() {
    local service="$1"
    local f
    for f in \
        "/etc/systemd/system/${service}.service" \
        "/lib/systemd/system/${service}.service" \
        "/usr/lib/systemd/system/${service}.service"; do
        [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
    return 1
}

service_exists() {
    systemctl cat "$1" >/dev/null 2>&1
}

service_active() {
    systemctl is-active --quiet "$1" 2>/dev/null
}

service_enabled() {
    systemctl is-enabled --quiet "$1" 2>/dev/null
}

port_listening() {
    local port="$1"
    ss -lntup 2>/dev/null | grep -Eq ":${port}([[:space:]]|$)"
}

backup_file() {
    local src="$1"
    local tag="${2:-manual}"
    [[ -e "$src" ]] || return 0

    local stamp dest
    stamp="$(date '+%Y%m%d-%H%M%S')"
    dest="${BACKUP_ROOT}/${stamp}-${tag}"
    mkdir -p "$dest"
    cp -a "$src" "$dest/"
    echo "$dest"
}

create_snapshot() {
    local reason="${1:-manual}"
    local stamp="${2:-$(date '+%Y%m%d-%H%M%S')}"
    local dir="${BACKUP_ROOT}/${stamp}-${reason}"

    mkdir -p "$dir"

    cat > "${dir}/MANIFEST.txt" <<EOF
OmniRoute Admin Backup
Version: ${SCRIPT_VERSION}
Fecha: $(date --iso-8601=seconds)
Host: $(hostname)
Reason: ${reason}
IP: $(get_lan_ip)
Interface: $(get_lan_interface || true)
CIDR: $(get_lan_cidr "$(get_lan_ip)" || true)
Gateway: $(get_gateway || true)
EOF

    local paths=(
        "/etc/systemd/system/${OMNI_SERVICE}.service"
        "/etc/systemd/system/${OMNI_SERVICE}.service.d"
        "/etc/systemd/system/${OLLAMA_SERVICE}.service.d"
        "$DNS_MAIN_CONFIG"
        "$DNS_LOCAL_CONFIG"
        "$DNS_VHOST_CONFIG"
        "$RESOLVED_DROPIN"
        "/etc/default/dnsmasq"
        "$SAMBA_CONFIG"
        "$SAMBA_MANAGED_CONFIG"
        "/etc/ufw/user.rules"
        "/etc/ufw/user6.rules"
    )

    local p safe
    for p in "${paths[@]}"; do
        [[ -e "$p" ]] || continue
        safe="${p#/}"
        safe="${safe//\//__}"
        mkdir -p "${dir}/files"
        cp -a "$p" "${dir}/files/${safe}"
        printf '%s\n' "$p" >> "${dir}/FILES.txt"
    done

    systemctl cat "$OMNI_SERVICE" > "${dir}/omniroute-systemd.txt" 2>&1 || true
    systemctl cat "$OLLAMA_SERVICE" > "${dir}/ollama-systemd.txt" 2>&1 || true
    ufw status numbered > "${dir}/ufw-status.txt" 2>&1 || true
    ss -lntup > "${dir}/listening-ports.txt" 2>&1 || true
    ip -4 addr > "${dir}/ip-address.txt" 2>&1 || true
    ip -4 route > "${dir}/ip-route.txt" 2>&1 || true
    resolvectl status > "${dir}/resolvectl-status.txt" 2>&1 || true

    printf '%s\n' "$dir" > "${BACKUP_ROOT}/LAST_BACKUP"
    ok "Backup creado: $dir"
    echo "$dir"
}

validate_backup() {
    local dir="$1"
    [[ -d "$dir" ]] || { error "Backup inexistente: $dir"; return 1; }
    [[ -f "${dir}/MANIFEST.txt" ]] || { error "Backup sin MANIFEST.txt"; return 1; }
    [[ -f "${dir}/FILES.txt" ]] || { warn "Backup sin FILES.txt."; }
    ok "Backup valido: $dir"
}

latest_backup() {
    if [[ -f "${BACKUP_ROOT}/LAST_BACKUP" ]]; then
        cat "${BACKUP_ROOT}/LAST_BACKUP"
        return 0
    fi
    find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
        sort -r | head -1
}

restore_path_from_backup() {
    local backup_dir="$1"
    local original="$2"
    local safe="${original#/}"
    safe="${safe//\//__}"
    local stored="${backup_dir}/files/${safe}"

    [[ -e "$stored" ]] || return 1

    if [[ -e "$original" || -L "$original" ]]; then
        rm -rf "$original"
    fi
    mkdir -p "$(dirname "$original")"
    cp -a "$stored" "$original"
}

restart_after_restore() {
    systemctl daemon-reload
    systemctl restart "$OLLAMA_SERVICE" 2>/dev/null || true
    systemctl restart "$OMNI_SERVICE" 2>/dev/null || true
    systemctl restart "$DNS_SERVICE" 2>/dev/null || true
    systemctl restart systemd-resolved 2>/dev/null || true
}

restore_backup() {
    separator
    echo -e "${WHITE}RESTAURAR CONFIGURACION${NC}"
    echo

    local dir="${1:-$(latest_backup)}"
    [[ -n "$dir" ]] || { error "No existe ningun backup."; pause_menu; return; }

    validate_backup "$dir" || { pause_menu; return; }

    echo "Backup: $dir"
    echo
    echo "Esto restaura solo archivos gestionados por este script."
    echo "No elimina paquetes instalados ni modifica VirtualHost de Apache."
    echo

    if [[ "$AUTO_YES" -ne 1 ]]; then
        read -r -p "Confirmar restauracion? [s/N]: " a
        [[ "${a,,}" == "s" ]] || return
    fi

    local originals=(
        "/etc/systemd/system/${OMNI_SERVICE}.service"
        "/etc/systemd/system/${OMNI_SERVICE}.service.d"
        "/etc/systemd/system/${OLLAMA_SERVICE}.service.d"
        "$DNS_MAIN_CONFIG"
        "$DNS_LOCAL_CONFIG"
        "$DNS_VHOST_CONFIG"
        "$RESOLVED_DROPIN"
        "/etc/default/dnsmasq"
        "$SAMBA_CONFIG"
        "$SAMBA_MANAGED_CONFIG"
        "/etc/ufw/user.rules"
        "/etc/ufw/user6.rules"
    )

    create_snapshot "pre-restore" >/dev/null

    local p
    for p in "${originals[@]}"; do
        if restore_path_from_backup "$dir" "$p"; then
            ok "Restaurado: $p"
        fi
    done

    restart_after_restore
    ok "Restauracion terminada."
    pause_menu
}

install_dependencies() {
    separator
    echo -e "${WHITE}DEPENDENCIAS${NC}"
    echo

    local pkgs=(
        curl
        ca-certificates
        jq
        dnsmasq
        dnsutils
        iproute2
        iputils-ping
        lsof
        net-tools
        python3
        samba
        samba-common-bin
        smbclient
    )

    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "[DRY-RUN] apt-get update"
        info "[DRY-RUN] apt-get install -y ${pkgs[*]}"
        return
    fi

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkgs[@]}"
    ok "Dependencias instaladas."
}

configure_service_dropin() {
    local service="$1"
    local dropin_dir="/etc/systemd/system/${service}.service.d"
    local dropin="${dropin_dir}/90-omniroute-admin.conf"

    mkdir -p "$dropin_dir"

    cat > "$dropin" <<EOF
[Service]
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
EOF

    echo "$dropin"
}

set_omniroute_binding() {
    separator
    echo -e "${WHITE}EXPOSICION DE OMNIROUTE${NC}"
    echo
    echo "1) Solo localhost       127.0.0.1"
    echo "2) Solo LAN              $(get_lan_ip)"
    echo "3) Todos los hosts IPv4 0.0.0.0"
    echo "4) Cancelar"
    echo

    local choice bind
    read -r -p "Seleccion: " choice

    case "$choice" in
        1) bind="127.0.0.1" ;;
        2) bind="$(get_lan_ip)" ;;
        3) bind="0.0.0.0" ;;
        *) return ;;
    esac

    create_snapshot "before-omniroute-binding" >/dev/null

    local dropin_dir="/etc/systemd/system/${OMNI_SERVICE}.service.d"
    local dropin="${dropin_dir}/90-omniroute-admin.conf"
    mkdir -p "$dropin_dir"

    cat > "$dropin" <<EOF
[Service]
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
Environment="NODE_ENV=production"
Environment="HOST=${bind}"
Environment="PORT=${OMNI_PORT_DEFAULT}"
EOF

    systemctl daemon-reload
    systemctl enable "$OMNI_SERVICE" >/dev/null 2>&1 || true
    systemctl restart "$OMNI_SERVICE"

    sleep 2
    if service_active "$OMNI_SERVICE"; then
        ok "OmniRoute activo con HOST=${bind}."
    else
        error "OmniRoute no inicio. Se recomienda restaurar el backup anterior."
        journalctl -u "$OMNI_SERVICE" -n 80 --no-pager || true
    fi
}

set_ollama_binding() {
    separator
    echo -e "${WHITE}EXPOSICION DE OLLAMA${NC}"
    echo
    echo "1) Solo localhost       127.0.0.1"
    echo "2) Solo LAN              $(get_lan_ip)"
    echo "3) Todos los hosts IPv4 0.0.0.0"
    echo "4) Cancelar"
    echo
    warn "Exponer Ollama permite que otros equipos consuman modelos y recursos del servidor."
    echo

    local choice bind
    read -r -p "Seleccion: " choice

    case "$choice" in
        1) bind="127.0.0.1" ;;
        2) bind="$(get_lan_ip)" ;;
        3) bind="0.0.0.0" ;;
        *) return ;;
    esac

    create_snapshot "before-ollama-binding" >/dev/null

    local dropin_dir="/etc/systemd/system/${OLLAMA_SERVICE}.service.d"
    local dropin="${dropin_dir}/90-omniroute-admin.conf"
    mkdir -p "$dropin_dir"

    cat > "$dropin" <<EOF
[Service]
Environment="OLLAMA_HOST=${bind}:${OLLAMA_PORT_DEFAULT}"
EOF

    systemctl daemon-reload
    systemctl enable "$OLLAMA_SERVICE" >/dev/null 2>&1 || true
    systemctl restart "$OLLAMA_SERVICE"

    sleep 2
    if service_active "$OLLAMA_SERVICE"; then
        ok "Ollama activo con OLLAMA_HOST=${bind}:${OLLAMA_PORT_DEFAULT}."
    else
        error "Ollama no inicio."
        journalctl -u "$OLLAMA_SERVICE" -n 80 --no-pager || true
    fi
}

install_samba() {
    separator
    echo -e "${WHITE}INSTALACION / VERIFICACION SAMBA${NC}"
    echo

    if ! command_exists apt-get; then
        error "apt-get no disponible."
        pause_menu
        return 1
    fi

    if command_exists smbd; then
        ok "Samba ya esta instalado."
    else
        info "Instalando Samba..."
        if [[ "$DRY_RUN" -eq 1 ]]; then
            info "[DRY-RUN] apt-get update"
            info "[DRY-RUN] apt-get install -y samba samba-common-bin smbclient"
        else
            apt-get update
            DEBIAN_FRONTEND=noninteractive apt-get install -y samba samba-common-bin smbclient
        fi
        ok "Samba instalado."
    fi

    if [[ "$DRY_RUN" -eq 0 ]]; then
        systemctl enable "$SAMBA_SERVICE" >/dev/null 2>&1 || true
        systemctl enable "$SAMBA_NMB_SERVICE" >/dev/null 2>&1 || true
        systemctl restart "$SAMBA_SERVICE" 2>/dev/null || true
        systemctl restart "$SAMBA_NMB_SERVICE" 2>/dev/null || true
    fi

    ok "Samba verificado."
    pause_menu
}

configure_samba() {
    separator
    echo -e "${WHITE}CONFIGURACION SAMBA${NC}"
    echo

    command_exists smbd || {
        error "Samba no esta instalado. Ejecuta primero la opcion de instalacion."
        pause_menu
        return 1
    }

    local lan_net
    lan_net="$(get_lan_network "$(get_lan_ip)" 2>/dev/null || true)"

    echo "Servidor       : $(hostname)"
    echo "IP LAN         : $(get_lan_ip)"
    echo "Red LAN        : ${lan_net:-desconocida}"
    echo
    echo "Esta configuracion:"
    echo "  - conserva smb.conf existente"
    echo "  - agrega un archivo gestionado por este script"
    echo "  - comparte /var/www como [www]"
    echo "  - no crea usuarios Samba automaticamente"
    echo "  - restringe el acceso a la LAN detectada"
    echo

    if [[ "$DRY_RUN" -eq 0 ]]; then
        create_snapshot "before-samba-config" >/dev/null
    fi

    mkdir -p "$SAMBA_INCLUDE_DIR"

    if [[ ! -f "$SAMBA_CONFIG" ]]; then
        cat > "$SAMBA_CONFIG" <<EOF
[global]
   workgroup = WORKGROUP
   server string = ${HOSTNAME:-IA-SERVER}
   security = user
   map to guest = Never
   include = ${SAMBA_INCLUDE_DIR}/*.conf
EOF
    elif ! grep -Eq '^[[:space:]]*include[[:space:]]*=[[:space:]]*/etc/samba/smb\.conf\.d/\*\.conf' "$SAMBA_CONFIG"; then
        printf '\n# Gestionado por %s\ninclude = %s/*.conf\n' "$APP_NAME" "$SAMBA_INCLUDE_DIR" >> "$SAMBA_CONFIG"
    fi

    cat > "$SAMBA_MANAGED_CONFIG" <<EOF
# Gestionado por ${APP_NAME} v${SCRIPT_VERSION}
# Acceso restringido a la LAN detectada.

[www]
   path = /var/www
   browseable = yes
   read only = no
   writable = yes
   valid users = %U
   create mask = 0664
   directory mask = 0775
   force create mode = 0664
   force directory mode = 0775
   hosts allow = ${lan_net:-127.0.0.1}
   hosts deny = 0.0.0.0/0
EOF

    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "[DRY-RUN] testparm -s"
        return 0
    fi

    if ! testparm -s >/tmp/omniroute-testparm.txt 2>&1; then
        error "La configuracion Samba es invalida:"
        cat /tmp/omniroute-testparm.txt
        return 1
    fi

    systemctl enable "$SAMBA_SERVICE" >/dev/null 2>&1 || true
    systemctl restart "$SAMBA_SERVICE"

    if service_active "$SAMBA_SERVICE"; then
        ok "Samba activo."
    else
        error "Samba no quedo activo."
        journalctl -u "$SAMBA_SERVICE" -n 80 --no-pager || true
        return 1
    fi

    if service_exists "$SAMBA_NMB_SERVICE"; then
        systemctl enable "$SAMBA_NMB_SERVICE" >/dev/null 2>&1 || true
        systemctl restart "$SAMBA_NMB_SERVICE" 2>/dev/null || true
    fi

    ok "Recurso [www] configurado."
    echo
    echo "Ruta Windows:"
    echo "\\\\$(get_lan_ip)\\www"
    echo
    echo "IMPORTANTE: el usuario debe existir en Linux y Samba."
    echo "Agregar usuario Samba:"
    echo "  sudo smbpasswd -a USUARIO"
    echo
    pause_menu
}

show_samba_status() {
    separator
    echo -e "${WHITE}ESTADO SAMBA${NC}"
    echo

    if ! command_exists smbd; then
        warn "Samba no esta instalado."
        pause_menu
        return
    fi

    echo "smbd:"
    systemctl --no-pager --full status "$SAMBA_SERVICE" 2>/dev/null || true
    echo
    echo "nmbd:"
    systemctl --no-pager --full status "$SAMBA_NMB_SERVICE" 2>/dev/null || true
    echo
    echo "Configuracion:"
    testparm -s 2>/dev/null || true
    echo
    echo "Recursos:"
    smbclient -L localhost -N 2>/dev/null || true
    echo
    echo "Usuarios Samba:"
    pdbedit -L 2>/dev/null || true
    echo
    echo "Puertos Samba:"
    ss -lntup 2>/dev/null | grep -E ':(137|138|139|445)([[:space:]]|$)' || true

    pause_menu
}

configure_samba_firewall() {
    separator
    echo -e "${WHITE}FIREWALL SAMBA${NC}"
    echo

    command_exists ufw || {
        error "UFW no esta instalado."
        pause_menu
        return
    }

    local lan_net
    lan_net="$(get_lan_network "$(get_lan_ip)" 2>/dev/null || true)"
    [[ -n "$lan_net" ]] || {
        error "No se pudo determinar la red LAN."
        pause_menu
        return
    }

    create_snapshot "before-ufw-samba" >/dev/null

    # SMB moderno: 445/TCP. NetBIOS: 137-139.
    # Se permite solamente desde la LAN detectada.
    ufw allow from "$lan_net" to any port 445 proto tcp
    ufw allow from "$lan_net" to any port 139 proto tcp
    ufw allow from "$lan_net" to any port 137 proto udp
    ufw allow from "$lan_net" to any port 138 proto udp

    ok "Samba permitido desde $lan_net."
    pause_menu
}

remove_samba_managed_config() {
    separator
    echo -e "${WHITE}REVERTIR SAMBA${NC}"
    echo

    if [[ "$AUTO_YES" -ne 1 ]]; then
        read -r -p "Eliminar solamente la configuracion gestionada por este script? [s/N]: " a
        [[ "${a,,}" == "s" ]] || return
    fi

    create_snapshot "before-revert-samba" >/dev/null

    rm -f "$SAMBA_MANAGED_CONFIG"

    if [[ -f "$SAMBA_CONFIG" ]]; then
        sed -i "\#^[[:space:]]*include[[:space:]]*=[[:space:]]*/etc/samba/smb.conf.d/\*\.conf[[:space:]]*$#d" "$SAMBA_CONFIG"
        sed -i "\#^[[:space:]]*# Gestionado por ${APP_NAME}#d" "$SAMBA_CONFIG" 2>/dev/null || true
    fi

    if testparm -s >/dev/null 2>&1; then
        systemctl restart "$SAMBA_SERVICE" 2>/dev/null || true
        ok "Configuracion gestionada de Samba revertida."
    else
        warn "La configuracion Samba existente requiere revision."
    fi

    pause_menu
}

samba_menu() {
    while true; do
        separator
        echo -e "${WHITE}ADMINISTRACION SAMBA${NC}"
        echo
        echo "1) Instalar / verificar Samba"
        echo "2) Configurar recurso [www]"
        echo "3) Ver estado y recursos"
        echo "4) Configurar firewall Samba (solo LAN)"
        echo "5) Revertir configuracion gestionada"
        echo "6) Ver usuarios Samba"
        echo "7) Ver testparm"
        echo "0) Volver"
        echo

        local c
        read -r -p "Seleccion: " c

        case "$c" in
            1) install_samba ;;
            2) configure_samba ;;
            3) show_samba_status ;;
            4) configure_samba_firewall ;;
            5) remove_samba_managed_config ;;
            6) pdbedit -L 2>/dev/null || true; pause_menu ;;
            7) testparm -s 2>/dev/null || true; pause_menu ;;
            0) return ;;
            *) warn "Opcion no valida." ;;
        esac
    done
}

configure_firewall() {
    separator
    echo -e "${WHITE}FIREWALL UFW${NC}"
    echo

    command_exists ufw || { error "UFW no esta instalado."; pause_menu; return; }

    local lan
    lan="$(get_lan_network 2>/dev/null || true)"

    echo "Red LAN detectada: ${lan:-no detectada}"
    echo
    echo "1) Permitir OmniRoute solo desde LAN"
    echo "2) Permitir Ollama solo desde LAN"
    echo "3) Permitir OmniRoute desde cualquier IPv4"
    echo "4) Permitir Ollama desde cualquier IPv4"
    echo "5) Permitir DNS TCP/UDP desde LAN"
    echo "6) Aplicar conjunto LAN completo"
    echo "7) Ver UFW"
    echo "8) Volver"
    echo

    local c
    read -r -p "Seleccion: " c

    case "$c" in
        1)
            [[ -n "$lan" ]] || { error "No se pudo determinar LAN."; return; }
            create_snapshot "before-ufw-omni-lan" >/dev/null
            ufw allow from "$lan" to any port "$OMNI_PORT_DEFAULT" proto tcp
            ok "OmniRoute permitido desde $lan."
            ;;
        2)
            [[ -n "$lan" ]] || { error "No se pudo determinar LAN."; return; }
            create_snapshot "before-ufw-ollama-lan" >/dev/null
            ufw allow from "$lan" to any port "$OLLAMA_PORT_DEFAULT" proto tcp
            ok "Ollama permitido desde $lan."
            ;;
        3)
            create_snapshot "before-ufw-omni-any" >/dev/null
            ufw allow "$OMNI_PORT_DEFAULT/tcp"
            ok "OmniRoute permitido desde cualquier IPv4."
            ;;
        4)
            create_snapshot "before-ufw-ollama-any" >/dev/null
            ufw allow "$OLLAMA_PORT_DEFAULT/tcp"
            ok "Ollama permitido desde cualquier IPv4."
            ;;
        5)
            [[ -n "$lan" ]] || { error "No se pudo determinar LAN."; return; }
            create_snapshot "before-ufw-dns" >/dev/null
            ufw allow from "$lan" to any port 53 proto udp
            ufw allow from "$lan" to any port 53 proto tcp
            ok "DNS permitido desde $lan."
            ;;
        6)
            [[ -n "$lan" ]] || { error "No se pudo determinar LAN."; return; }
            create_snapshot "before-ufw-full-lan" >/dev/null
            ufw allow from "$lan" to any port "$OMNI_PORT_DEFAULT" proto tcp
            ufw allow from "$lan" to any port "$OLLAMA_PORT_DEFAULT" proto tcp
            ufw allow from "$lan" to any port 53 proto udp
            ufw allow from "$lan" to any port 53 proto tcp
            ok "Conjunto LAN aplicado."
            ;;
        7)
            ufw status numbered
            ;;
        *) return ;;
    esac
    pause_menu
}

remove_ufw_rule_interactive() {
    command_exists ufw || return
    separator
    echo -e "${WHITE}REVERTIR REGLAS UFW${NC}"
    echo
    ufw status numbered
    echo
    read -r -p "Numero de regla a eliminar (ENTER cancela): " n
    [[ -n "$n" ]] || return
    [[ "$n" =~ ^[0-9]+$ ]] || { error "Numero invalido."; return; }

    create_snapshot "before-ufw-delete" >/dev/null
    ufw --force delete "$n" || warn "No fue posible eliminar la regla."
    pause_menu
}

configure_dns_server() {
    separator
    echo -e "${WHITE}SERVIDOR DNS LOCAL${NC}"
    echo

    local lan_ip iface lan_net
    lan_ip="$(get_lan_ip)"
    iface="$(get_lan_interface || true)"
    lan_net="$(get_lan_network "$lan_ip" 2>/dev/null || true)"

    echo "IP del servidor : $lan_ip"
    echo "Interfaz LAN    : ${iface:-desconocida}"
    echo "Red LAN         : ${lan_net:-desconocida}"
    echo
    echo "El servicio utilizado sera dnsmasq."
    echo "No se habilitara DHCP: solo DNS."
    echo

    if ! command_exists dnsmasq; then
        error "dnsmasq no esta instalado. Usa Dependencias."
        pause_menu
        return
    fi

    create_snapshot "before-dns-config" >/dev/null

    mkdir -p "$DNS_CONFIG_DIR"

    cat > "$DNS_LOCAL_CONFIG" <<EOF
# Gestionado por ${APP_NAME} v${SCRIPT_VERSION}
# DNS local para VirtualHost / servicios internos.

no-dhcp-interface=${iface:-lo}
interface=${iface:-lo}
listen-address=127.0.0.1,${lan_ip}
bind-dynamic

domain-needed
bogus-priv
no-resolv

# DNS upstream.
server=1.1.1.1
server=9.9.9.9
server=8.8.8.8

# Cache.
cache-size=1000
EOF

    # No reemplazar el dnsmasq.conf original: solo aseguramos que incluya conf.d.
    if [[ -f "$DNS_MAIN_CONFIG" ]] && ! grep -Eq '^[[:space:]]*conf-dir=/etc/dnsmasq\.d' "$DNS_MAIN_CONFIG"; then
        printf '\n# Gestionado por %s\nconf-dir=/etc/dnsmasq.d,*.conf\n' "$APP_NAME" >> "$DNS_MAIN_CONFIG"
    elif [[ ! -f "$DNS_MAIN_CONFIG" ]]; then
        cat > "$DNS_MAIN_CONFIG" <<EOF
# Gestionado por ${APP_NAME}
conf-dir=/etc/dnsmasq.d,*.conf
EOF
    fi

    # systemd-resolved: conservarlo para resolver local, pero liberar el puerto 53.
    mkdir -p "$RESOLVED_DROPIN_DIR"
    cat > "$RESOLVED_DROPIN" <<EOF
# Gestionado por ${APP_NAME}
[Resolve]
DNS=127.0.0.1
DNSStubListener=no
EOF

    systemctl daemon-reload
    systemctl restart systemd-resolved 2>/dev/null || true

    if ! dnsmasq --test; then
        error "La configuracion de dnsmasq es invalida. No se reinicia."
        return 1
    fi

    systemctl enable "$DNS_SERVICE" >/dev/null 2>&1 || true
    systemctl restart "$DNS_SERVICE"

    sleep 2

    if service_active "$DNS_SERVICE"; then
        ok "dnsmasq activo."
    else
        error "dnsmasq no quedo activo."
        journalctl -u "$DNS_SERVICE" -n 80 --no-pager || true
        return 1
    fi

    if port_listening 53; then
        ok "Puerto DNS 53 escuchando."
    else
        warn "No se detecta puerto 53 escuchando."
    fi

    echo
    echo "DNS del servidor: ${lan_ip}:53"
    echo "Clientes LAN deben usar ${lan_ip} como DNS."
    echo
    warn "Si MikroTik entrega DHCP, configura ${lan_ip} como DNS entregado a los clientes."
    pause_menu
}

add_dns_record() {
    separator
    echo -e "${WHITE}AGREGAR REGISTRO DNS LOCAL${NC}"
    echo

    local host ip
    read -r -p "Nombre DNS (ej. pccontrolhub.local): " host
    read -r -p "IP destino [$(get_lan_ip)]: " ip
    ip="${ip:-$(get_lan_ip)}"

    valid_hostname "$host" || { error "Hostname invalido."; pause_menu; return; }
    valid_ipv4 "$ip" || { error "IPv4 invalida."; pause_menu; return; }

    create_snapshot "before-dns-record" >/dev/null
    mkdir -p "$DNS_CONFIG_DIR"
    touch "$DNS_VHOST_CONFIG"

    if grep -Eq "^[[:space:]]*address=/${host//./\\.}/" "$DNS_VHOST_CONFIG"; then
        warn "El registro ya existe."
        pause_menu
        return
    fi

    printf 'address=/%s/%s\n' "$host" "$ip" >> "$DNS_VHOST_CONFIG"

    if dnsmasq --test; then
        systemctl restart "$DNS_SERVICE"
        ok "${host} -> ${ip}"
    else
        error "dnsmasq rechazo la configuracion. Restaurando backup."
        restore_backup "$(latest_backup)" || true
    fi
    pause_menu
}

remove_dns_record() {
    separator
    echo -e "${WHITE}ELIMINAR REGISTRO DNS LOCAL${NC}"
    echo
    [[ -f "$DNS_VHOST_CONFIG" ]] || { warn "No hay registros."; pause_menu; return; }

    cat "$DNS_VHOST_CONFIG"
    echo
    local host
    read -r -p "Hostname a eliminar: " host
    [[ -n "$host" ]] || return

    create_snapshot "before-dns-record-delete" >/dev/null

    sed -i "\#^[[:space:]]*address=/${host//./\\.}/#d" "$DNS_VHOST_CONFIG"

    dnsmasq --test
    systemctl restart "$DNS_SERVICE"
    ok "Registro eliminado si existia."
    pause_menu
}

import_apache_vhosts() {
    separator
    echo -e "${WHITE}DETECTAR VIRTUALHOST DE APACHE${NC}"
    echo

    command_exists apache2ctl || {
        error "apache2ctl no esta disponible."
        pause_menu
        return
    }

    local vhosts
    vhosts="$(apache2ctl -S 2>&1 || true)"

    echo "$vhosts"
    echo

    local ip
    read -r -p "IP que deben resolver los VirtualHost locales [$(get_lan_ip)]: " ip
    ip="${ip:-$(get_lan_ip)}"
    valid_ipv4 "$ip" || { error "IPv4 invalida."; pause_menu; return; }

    create_snapshot "before-apache-vhost-import" >/dev/null
    mkdir -p "$DNS_CONFIG_DIR"
    touch "$DNS_VHOST_CONFIG"

    local names
    names="$(printf '%s\n' "$vhosts" |
        grep -Eo 'namevhost [^ ]+|alias [^ ]+' |
        awk '{print $2}' |
        grep -E '^[A-Za-z0-9][A-Za-z0-9.-]*$' |
        sort -u || true)"

    if [[ -z "$names" ]]; then
        warn "No se detectaron nombres de VirtualHost/alias."
        pause_menu
        return
    fi

    local n added=0
    while IFS= read -r n; do
        [[ -n "$n" ]] || continue
        if ! grep -Eq "^[[:space:]]*address=/${n//./\\.}/" "$DNS_VHOST_CONFIG"; then
            printf 'address=/%s/%s\n' "$n" "$ip" >> "$DNS_VHOST_CONFIG"
            echo "  + $n -> $ip"
            ((added+=1))
        else
            echo "  = $n ya existe"
        fi
    done <<< "$names"

    dnsmasq --test
    systemctl restart "$DNS_SERVICE"
    ok "VirtualHost importados: $added"
    pause_menu
}

show_dns_records() {
    separator
    echo -e "${WHITE}REGISTROS DNS LOCALES${NC}"
    echo

    echo "Archivo: $DNS_VHOST_CONFIG"
    echo
    if [[ -f "$DNS_VHOST_CONFIG" ]]; then
        cat "$DNS_VHOST_CONFIG"
    else
        echo "Sin registros gestionados."
    fi

    echo
    echo "Estado dnsmasq:"
    systemctl --no-pager --full status "$DNS_SERVICE" 2>/dev/null || true

    echo
    echo "Puertos:"
    ss -lntup 2>/dev/null | grep -E '(:53[[:space:]]|:53$)' || true

    pause_menu
}

test_dns() {
    separator
    echo -e "${WHITE}PRUEBA DNS${NC}"
    echo

    local ip
    ip="$(get_lan_ip)"

    echo "Servidor DNS: $ip"
    echo

    if command_exists dig; then
        read -r -p "Hostname a consultar [pccontrolhub.local]: " host
        host="${host:-pccontrolhub.local}"

        echo
        dig @"$ip" "$host" A +short
        echo
        dig @127.0.0.1 "$host" A +short
    else
        warn "dig no esta instalado."
    fi

    echo
    resolvectl status 2>/dev/null || true
    pause_menu
}

configure_mikrotik_dns_note() {
    separator
    echo -e "${WHITE}CONFIGURACION DE CLIENTES DNS${NC}"
    echo
    echo "Este script no modifica MikroTik."
    echo
    echo "Para que todos los clientes LAN resuelvan los VHost:"
    echo "  DNS primario DHCP -> $(get_lan_ip)"
    echo
    echo "En tu MikroTik puedes entregar esa IP como DNS por DHCP."
    echo "El servidor Ubuntu debe permitir TCP/UDP 53 desde la LAN."
    echo
    echo "Ejemplo conceptual:"
    echo "  Cliente -> MikroTik DHCP -> DNS $(get_lan_ip) -> dnsmasq"
    echo "  VHost -> $(get_lan_ip)"
    echo
    pause_menu
}

configure_dns_menu() {
    while true; do
        separator
        echo -e "${WHITE}ADMINISTRACION DNS${NC}"
        echo
        echo "1) Instalar/verificar dnsmasq"
        echo "2) Configurar servidor DNS local"
        echo "3) Agregar registro DNS"
        echo "4) Eliminar registro DNS"
        echo "5) Detectar/importar VirtualHost Apache"
        echo "6) Ver registros y estado"
        echo "7) Probar DNS"
        echo "8) Ver instrucciones para MikroTik"
        echo "0) Volver"
        echo

        local c
        read -r -p "Seleccion: " c
        case "$c" in
            1) install_dependencies; pause_menu ;;
            2) configure_dns_server ;;
            3) add_dns_record ;;
            4) remove_dns_record ;;
            5) import_apache_vhosts ;;
            6) show_dns_records ;;
            7) test_dns ;;
            8) configure_mikrotik_dns_note ;;
            0) return ;;
            *) warn "Opcion no valida." ;;
        esac
    done
}

show_service_detail() {
    local service="$1"
    separator
    echo -e "${WHITE}SERVICIO: ${service}${NC}"
    echo

    if ! service_exists "$service"; then
        warn "Servicio no instalado/no registrado."
        return
    fi

    echo "Activo   : $(service_active "$service" && echo SI || echo NO)"
    echo "Enabled  : $(service_enabled "$service" && echo SI || echo NO)"
    echo "Estado   :"
    systemctl --no-pager --full status "$service" 2>/dev/null || true

    echo
    echo "Unit:"
    systemctl cat "$service" 2>/dev/null || true
}

show_ports() {
    separator
    echo -e "${WHITE}PUERTOS ESCUCHANDO${NC}"
    echo
    ss -lntup 2>/dev/null
    echo
    echo "Puertos esperados:"
    for p in "$OMNI_PORT_DEFAULT" "$OLLAMA_PORT_DEFAULT" "$DNS_PORT" "445"; do
        if port_listening "$p"; then
            ok "TCP/UDP $p: escuchando"
        else
            warn "Puerto $p: no detectado"
        fi
    done
    pause_menu
}

show_system() {
    separator
    echo -e "${WHITE}ESTADO DEL SERVIDOR${NC}"
    echo

    echo "Hostname       : $(hostname)"
    echo "IP LAN         : $(get_lan_ip)"
    echo "Interfaz       : $(get_lan_interface || echo desconocida)"
    echo "CIDR           : $(get_lan_cidr "$(get_lan_ip)" || echo desconocido)"
    echo "Red            : $(get_lan_network "$(get_lan_ip)" 2>/dev/null || echo desconocida)"
    echo "Gateway        : $(get_gateway || echo desconocido)"
    echo "Kernel         : $(uname -r)"
    echo "Arquitectura   : $(uname -m)"
    echo

    echo "CPU:"
    nproc
    echo

    echo "Memoria:"
    free -h
    echo

    echo "Disco:"
    df -h /
    echo

    echo "Uptime:"
    uptime -p 2>/dev/null || uptime

    pause_menu
}

check_omniroute() {
    detect_omniroute
    echo "Comando: ${OMNI_CMD:-NO ENCONTRADO}"
    echo "Servicio: ${OMNI_SERVICE}"

    if service_exists "$OMNI_SERVICE"; then
        service_active "$OMNI_SERVICE" && ok "Servicio activo." || warn "Servicio inactivo."
        service_enabled "$OMNI_SERVICE" && ok "Servicio habilitado." || warn "Servicio no habilitado."
    else
        warn "No existe unidad systemd."
    fi

    if [[ -n "$OMNI_CMD" ]]; then
        "$OMNI_CMD" --version 2>/dev/null ||
            "$OMNI_CMD" version 2>/dev/null ||
            warn "CLI no devolvio version."
    fi
}

check_ollama() {
    if ! command_exists ollama; then
        error "Ollama no esta instalado."
        return 1
    fi

    ok "Ollama CLI encontrado."
    service_exists "$OLLAMA_SERVICE" &&
        service_active "$OLLAMA_SERVICE" && ok "Servicio activo." ||
        warn "Servicio Ollama inactivo/no registrado."

    if curl -fsS --max-time 5 "http://127.0.0.1:${OLLAMA_PORT_DEFAULT}/api/tags" >/dev/null 2>&1; then
        ok "API Ollama responde."
    else
        warn "API Ollama no responde en localhost."
    fi
}

test_omniroute() {
    separator
    echo -e "${WHITE}HEALTH CHECK OMNIROUTE${NC}"
    echo

    local url="http://127.0.0.1:${OMNI_PORT_DEFAULT}"
    local lan="http://$(get_lan_ip):${OMNI_PORT_DEFAULT}"

    echo "Local: $url"
    if curl -sS -I --max-time 10 "$url" >/tmp/omni-head.txt 2>&1; then
        ok "HTTP local responde."
        head -20 /tmp/omni-head.txt
    else
        warn "HTTP local no responde."
        cat /tmp/omni-head.txt 2>/dev/null || true
    fi

    echo
    echo "OpenAI API: ${url}/v1/models"
    local response
    response="$(curl -sS --max-time 15 -w $'\nHTTP_STATUS:%{http_code}\n' "${url}/v1/models" 2>&1 || true)"
    printf '%s\n' "$response" | head -c 8000
    echo

    echo
    echo "LAN: $lan"
    if curl -sS -I --max-time 5 "$lan" >/dev/null 2>&1; then
        ok "OmniRoute accesible por IP LAN."
    else
        warn "OmniRoute no responde por IP LAN."
    fi

    pause_menu
}

test_ollama() {
    separator
    echo -e "${WHITE}HEALTH CHECK OLLAMA${NC}"
    echo

    echo "API tags:"
    curl -sS --max-time 10 "http://127.0.0.1:${OLLAMA_PORT_DEFAULT}/api/tags" |
        jq . 2>/dev/null || true

    echo
    echo "Modelos:"
    ollama list 2>/dev/null || true

    echo
    echo "Modelos cargados:"
    ollama ps 2>/dev/null || true

    pause_menu
}

test_integration() {
    separator
    echo -e "${WHITE}PRUEBA DE INTEGRACION OMNIROUTE -> OLLAMA${NC}"
    echo

    if ! service_active "$OLLAMA_SERVICE"; then
        warn "Ollama no esta activo."
    fi

    if ! service_active "$OMNI_SERVICE"; then
        warn "OmniRoute no esta activo."
    fi

    echo "Ollama:"
    curl -fsS --max-time 5 "http://127.0.0.1:${OLLAMA_PORT_DEFAULT}/api/tags" >/dev/null &&
        ok "Backend Ollama responde." ||
        error "Backend Ollama no responde."

    echo
    echo "OmniRoute:"
    curl -fsS --max-time 10 "http://127.0.0.1:${OMNI_PORT_DEFAULT}/v1/models" >/tmp/omni-models.json &&
        ok "API /v1/models responde." ||
        error "API /v1/models no responde."

    if [[ -s /tmp/omni-models.json ]]; then
        echo
        jq . /tmp/omni-models.json 2>/dev/null | head -100 || head -100 /tmp/omni-models.json
    fi

    pause_menu
}

show_status() {
    separator
    echo -e "${WHITE}${APP_NAME} v${SCRIPT_VERSION} - ESTADO${NC}"
    echo

    detect_omniroute

    printf '%-20s : %s\n' "Hostname" "$(hostname)"
    printf '%-20s : %s\n' "IP LAN" "$(get_lan_ip)"
    printf '%-20s : %s\n' "Interfaz" "$(get_lan_interface || echo '?')"
    printf '%-20s : %s\n' "Red" "$(get_lan_network "$(get_lan_ip)" 2>/dev/null || echo '?')"
    printf '%-20s : %s\n' "OmniRoute CLI" "${OMNI_CMD:-NO}"
    printf '%-20s : %s\n' "OmniRoute service" "$(service_active "$OMNI_SERVICE" && echo ACTIVO || echo INACTIVO)"
    printf '%-20s : %s\n' "Ollama service" "$(service_active "$OLLAMA_SERVICE" && echo ACTIVO || echo INACTIVO)"
    printf '%-20s : %s\n' "DNS service" "$(service_active "$DNS_SERVICE" && echo ACTIVO || echo INACTIVO)"
    printf '%-20s : %s\n' "Samba service" "$(service_active "$SAMBA_SERVICE" && echo ACTIVO || echo INACTIVO)"
    printf '%-20s : %s\n' "Puerto OmniRoute" "$(port_listening "$OMNI_PORT_DEFAULT" && echo LISTEN || echo CLOSED)"
    printf '%-20s : %s\n' "Puerto Ollama" "$(port_listening "$OLLAMA_PORT_DEFAULT" && echo LISTEN || echo CLOSED)"
    printf '%-20s : %s\n' "Puerto DNS" "$(port_listening "$DNS_PORT" && echo LISTEN || echo CLOSED)"

    echo
    echo "Bindings:"
    ss -lntup 2>/dev/null | grep -E ":(${OMNI_PORT_DEFAULT}|${OLLAMA_PORT_DEFAULT}|53|445)([[:space:]]|$)" || true

    pause_menu
}

show_logs() {
    separator
    echo -e "${WHITE}LOGS${NC}"
    echo
    echo "1) OmniRoute"
    echo "2) Ollama"
    echo "3) dnsmasq"
    echo "4) Este script"
    echo "0) Volver"
    echo

    local c
    read -r -p "Seleccion: " c

    case "$c" in
        1) journalctl -u "$OMNI_SERVICE" -n 200 --no-pager ;;
        2) journalctl -u "$OLLAMA_SERVICE" -n 200 --no-pager ;;
        3) journalctl -u "$DNS_SERVICE" -n 200 --no-pager ;;
        4) tail -n 250 "$LOG_FILE" 2>/dev/null || true ;;
        *) return ;;
    esac
    pause_menu
}

diagnose() {
    separator
    echo -e "${WHITE}DIAGNOSTICO COMPLETO${NC}"
    echo

    show_system

    separator
    echo "=== SERVICIOS ==="
    check_omniroute || true
    echo
    check_ollama || true
    echo
    service_exists "$DNS_SERVICE" && show_service_detail "$DNS_SERVICE" || true

    separator
    echo "=== SAMBA ==="
    if command_exists smbd; then
        systemctl --no-pager --full status "$SAMBA_SERVICE" 2>/dev/null || true
        testparm -s 2>/dev/null || true
        pdbedit -L 2>/dev/null || true
    else
        echo "Samba no instalado."
    fi

    separator
    echo "=== PUERTOS ==="
    ss -lntup 2>/dev/null | grep -E ":(${OMNI_PORT_DEFAULT}|${OLLAMA_PORT_DEFAULT}|53|445)([[:space:]]|$)" || true

    separator
    echo "=== RED ==="
    ip -4 addr
    echo
    ip -4 route

    separator
    echo "=== DNS ==="
    resolvectl status 2>/dev/null || true

    separator
    echo "=== FIREWALL ==="
    ufw status verbose 2>/dev/null || true

    separator
    echo "=== API OLLAMA ==="
    curl -sS --max-time 5 "http://127.0.0.1:${OLLAMA_PORT_DEFAULT}/api/tags" |
        jq . 2>/dev/null | head -100 || true

    separator
    echo "=== API OMNIROUTE ==="
    curl -sS --max-time 10 "http://127.0.0.1:${OMNI_PORT_DEFAULT}/v1/models" |
        jq . 2>/dev/null | head -100 || true

    pause_menu
}

revert_menu() {
    while true; do
        separator
        echo -e "${WHITE}REVERSAR CONFIGURACIONES${NC}"
        echo
        echo "1) Restaurar ultimo snapshot completo"
        echo "2) Restaurar un backup seleccionado"
        echo "3) Revertir configuracion DNS gestionada"
        echo "4) Revertir override de Ollama"
        echo "5) Revertir override de OmniRoute"
        echo "6) Eliminar registros DNS gestionados"
        echo "7) Eliminar reglas UFW interactivamente"
        echo "0) Volver"
        echo

        local c
        read -r -p "Seleccion: " c

        case "$c" in
            1) restore_backup ;;
            2)
                list_backups
                echo
                read -r -p "Ruta exacta del backup: " b
                [[ -n "$b" ]] && restore_backup "$b"
                ;;
            3)
                create_snapshot "before-revert-dns" >/dev/null
                rm -f "$DNS_LOCAL_CONFIG" "$DNS_VHOST_CONFIG" "$RESOLVED_DROPIN"
                systemctl restart "$DNS_SERVICE" 2>/dev/null || true
                systemctl restart systemd-resolved 2>/dev/null || true
                ok "Archivos DNS gestionados eliminados."
                ;;
            4)
                create_snapshot "before-revert-ollama" >/dev/null
                rm -f "/etc/systemd/system/${OLLAMA_SERVICE}.service.d/90-omniroute-admin.conf"
                systemctl daemon-reload
                systemctl restart "$OLLAMA_SERVICE" 2>/dev/null || true
                ok "Override Ollama eliminado."
                ;;
            5)
                create_snapshot "before-revert-omniroute" >/dev/null
                rm -f "/etc/systemd/system/${OMNI_SERVICE}.service.d/90-omniroute-admin.conf"
                systemctl daemon-reload
                systemctl restart "$OMNI_SERVICE" 2>/dev/null || true
                ok "Override OmniRoute eliminado."
                ;;
            6)
                create_snapshot "before-revert-dns-records" >/dev/null
                rm -f "$DNS_VHOST_CONFIG"
                systemctl restart "$DNS_SERVICE" 2>/dev/null || true
                ok "Registros DNS gestionados eliminados."
                ;;
            7) remove_ufw_rule_interactive ;;
            0) return ;;
            *) warn "Opcion no valida." ;;
        esac
    done
}

list_backups() {
    separator
    echo -e "${WHITE}BACKUPS${NC}"
    echo

    mkdir -p "$BACKUP_ROOT"
    local dirs
    dirs="$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r || true)"

    if [[ -z "$dirs" ]]; then
        echo "No existen backups."
        return
    fi

    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        local manifest="$d/MANIFEST.txt"
        if [[ -f "$manifest" ]]; then
            echo "------------------------------------------------------------"
            echo "$d"
            grep -E '^(Fecha|Host|Reason|IP|CIDR|Gateway):' "$manifest" || true
        else
            echo "$d"
        fi
    done <<< "$dirs"

    echo
    echo "Ultimo:"
    latest_backup || true
    pause_menu
}

configure_services_menu() {
    while true; do
        separator
        echo -e "${WHITE}SERVICIOS IA${NC}"
        echo
        echo "1) Ver estado OmniRoute"
        echo "2) Ver estado Ollama"
        echo "3) Exposicion OmniRoute"
        echo "4) Exposicion Ollama"
        echo "5) Reiniciar OmniRoute"
        echo "6) Reiniciar Ollama"
        echo "7) Reiniciar ambos"
        echo "8) Probar OmniRoute"
        echo "9) Probar Ollama"
        echo "10) Probar integracion"
        echo "0) Volver"
        echo

        local c
        read -r -p "Seleccion: " c

        case "$c" in
            1) show_service_detail "$OMNI_SERVICE"; pause_menu ;;
            2) show_service_detail "$OLLAMA_SERVICE"; pause_menu ;;
            3) set_omniroute_binding ;;
            4) set_ollama_binding ;;
            5) create_snapshot "before-omni-restart" >/dev/null; systemctl restart "$OMNI_SERVICE"; ok "OmniRoute reiniciado."; pause_menu ;;
            6) create_snapshot "before-ollama-restart" >/dev/null; systemctl restart "$OLLAMA_SERVICE"; ok "Ollama reiniciado."; pause_menu ;;
            7) create_snapshot "before-services-restart" >/dev/null; systemctl restart "$OLLAMA_SERVICE"; systemctl restart "$OMNI_SERVICE"; ok "Servicios reiniciados."; pause_menu ;;
            8) test_omniroute ;;
            9) test_ollama ;;
            10) test_integration ;;
            0) return ;;
            *) warn "Opcion no valida." ;;
        esac
    done
}

full_configuration() {
    separator
    echo -e "${WHITE}CONFIGURACION COMPLETA ASISTIDA${NC}"
    echo

    info "Se creara un snapshot antes de modificar configuraciones."
    create_snapshot "before-full-configuration" >/dev/null

    install_dependencies

    if service_exists "$OLLAMA_SERVICE"; then
        echo
        echo "Configuracion Ollama:"
        echo "1) localhost"
        echo "2) LAN"
        echo "3) todos los hosts IPv4"
        echo
        local o
        read -r -p "Seleccion [1]: " o
        o="${o:-1}"
        case "$o" in
            1) set_ollama_binding ;;
            2) set_ollama_binding ;;
            3) set_ollama_binding ;;
            *) warn "Ollama no modificado." ;;
        esac
    else
        warn "Servicio Ollama no encontrado."
    fi

    if service_exists "$OMNI_SERVICE"; then
        echo
        echo "Configuracion OmniRoute:"
        echo "1) localhost"
        echo "2) LAN"
        echo "3) todos los hosts IPv4"
        echo
        local m
        read -r -p "Seleccion [2]: " m
        m="${m:-2}"
        case "$m" in
            1|2|3) set_omniroute_binding ;;
            *) warn "OmniRoute no modificado." ;;
        esac
    else
        warn "Servicio OmniRoute no encontrado."
    fi

    echo
    read -r -p "Configurar servidor DNS local ahora? [S/n]: " d
    if [[ "${d,,}" != "n" ]]; then
        configure_dns_server
    fi

    echo
    read -r -p "Instalar/configurar Samba ahora? [S/n]: " s
    if [[ "${s,,}" != "n" ]]; then
        install_samba
        configure_samba
        configure_samba_firewall
    fi

    echo
    read -r -p "Configurar reglas UFW LAN ahora? [S/n]: " f
    if [[ "${f,,}" != "n" ]]; then
        configure_firewall
    fi

    echo
    test_integration || true
    ok "Configuracion asistida terminada."
    pause_menu
}

show_header() {
    clear
    echo -e "${CYAN}"
    cat <<'EOF'
 ██████╗ ███╗   ███╗███╗   ██╗██╗██████╗  ██████╗ ██╗   ██╗████████╗███████╗
██╔═══██╗████╗ ████║████╗  ██║██║██╔══██╗██╔═══██╗██║   ██║╚══██╔══╝██╔════╝
██║   ██║██╔████╔██║██╔██╗ ██║██║██████╔╝██║   ██║██║   ██║   ██║   █████╗
██║   ██║██║╚██╔╝██║██║╚██╗██║██║██╔══██╗██║   ██║██║   ██║   ██║   ██╔══╝
╚██████╔╝██║ ╚═╝ ██║██║ ╚████║██║██║  ██║╚██████╔╝╚██████╔╝   ██║   ███████╗
 ╚═════╝ ╚═╝     ╚═╝╚═╝  ╚═══╝╚═╝╚═╝  ╚═╝ ╚═════╝  ╚═════╝    ╚═╝   ╚══════╝
EOF
    echo -e "${NC}"
    echo -e "${WHITE}${APP_NAME} v${SCRIPT_VERSION}${NC}"
    echo "PCCURICO SPA - IA-SERVER"
    echo
}

main_menu() {
    while true; do
        show_header

        local ip
        ip="$(get_lan_ip)"

        echo "Servidor : $(hostname)"
        echo "IP LAN   : $ip"
        echo "OmniRoute: :${OMNI_PORT_DEFAULT}"
        echo "Ollama   : :${OLLAMA_PORT_DEFAULT}"
        echo "DNS      : :53"
        [[ "$DRY_RUN" -eq 1 ]] && echo -e "${MAGENTA}MODO DRY-RUN ACTIVO${NC}"

        echo
        printf '%*s\n' 82 '' | tr ' ' '-'
        echo
        echo " 1) Configuracion completa asistida"
        echo " 2) Estado general"
        echo " 3) Diagnostico completo"
        echo " 4) Administrar OmniRoute / Ollama"
        echo " 5) Administrar DNS / VirtualHost"
        echo " 6) Administrar Samba"
        echo " 7) Firewall UFW"
        echo " 8) Puertos y red"
        echo " 9) Backups"
        echo "10) Revertir configuraciones"
        echo "11) Logs"
        echo "12) Instalar/verificar dependencias"
        echo " 0) Salir"
        echo

        local option
        read -r -p "Seleccion: " option

        case "$option" in
            1) full_configuration ;;
            2) show_status ;;
            3) diagnose ;;
            4) configure_services_menu ;;
            5) configure_dns_menu ;;
            6) samba_menu ;;
            7) configure_firewall ;;
            8) show_ports ;;
            9) list_backups ;;
            10) revert_menu ;;
            11) show_logs ;;
            12) install_dependencies; pause_menu ;;
            0)
                echo
                ok "Administrador finalizado."
                exit 0
                ;;
            *) warn "Opcion no valida."; sleep 1 ;;
        esac
    done
}

show_help() {
    cat <<EOF
${APP_NAME} v${SCRIPT_VERSION}

Uso:
  sudo bash $0
  sudo bash $0 --status
  sudo bash $0 --diagnose
  sudo bash $0 --full
  sudo bash $0 --dry-run
  sudo bash $0 --help

Opciones:
  --status       Muestra estado resumido y termina.
  --diagnose     Diagnostico completo y termina.
  --full         Ejecuta configuracion asistida.
  --dry-run      No realiza modificaciones; muestra operaciones.
  --yes          Acepta confirmaciones compatibles.
  --non-interactive
                 Evita pausas del menu.
  --debug        Logging adicional.
  --help         Esta ayuda.

Puertos por defecto:
  OmniRoute: ${OMNI_PORT_DEFAULT}/tcp
  Ollama:    ${OLLAMA_PORT_DEFAULT}/tcp
  DNS:       53/tcp + 53/udp
  Samba:     445/tcp + NetBIOS 137/138/139

Backups:
  ${BACKUP_ROOT}

Log:
  ${LOG_FILE}
EOF
}

parse_args() {
    while (($#)); do
        case "$1" in
            --status)
                MODE="status"
                ;;
            --diagnose)
                MODE="diagnose"
                ;;
            --full)
                MODE="full"
                ;;
            --dry-run)
                DRY_RUN=1
                ;;
            --yes)
                AUTO_YES=1
                ;;
            --non-interactive)
                NON_INTERACTIVE=1
                ;;
            --debug)
                DEBUG=1
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                die "Parametro desconocido: $1. Usa --help."
                ;;
        esac
        shift
    done
}

init() {
    require_root
    acquire_lock

    mkdir -p "$BACKUP_ROOT" "$STATE_ROOT"
    touch "$LOG_FILE" 2>/dev/null || true

    if [[ -f /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        if [[ "${ID:-}" != "ubuntu" ]]; then
            warn "Sistema detectado: ${PRETTY_NAME:-desconocido}"
        fi
        if [[ "${VERSION_ID:-}" != "24.04" ]]; then
            warn "Version detectada: ${VERSION_ID:-desconocida}; objetivo Ubuntu 24.04 LTS."
        fi
    else
        warn "No se pudo identificar el sistema operativo."
    fi

    command_exists ip || die "iproute2 es obligatorio."
    command_exists systemctl || die "systemd/systemctl es obligatorio."

    detect_omniroute

    log_raw "============================================================"
    log_raw "Inicio ${APP_NAME} v${SCRIPT_VERSION}"
    log_raw "Hostname: $(hostname)"
    log_raw "IP LAN: $(get_lan_ip)"
    log_raw "============================================================"
}

MODE="menu"

parse_args "$@"
init

case "$MODE" in
    status)
        show_status
        ;;
    diagnose)
        diagnose
        ;;
    full)
        full_configuration
        ;;
    menu)
        main_menu
        ;;
esac
